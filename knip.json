{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "integrations/**/*.ts"
      ],
      "project": [
        "scripts/**/*.ts",
        "integrations/**/*.ts"
      ]
    },
    "apps/server": {
      "entry": [
        "scripts/*.ts",
        "src/**/*.test.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "src/routes/**/*.tsx"
      ]
    },
    "packages/agent-adapter": {
      "entry": [
        "src/**/*.test.ts"
      ]
    }
  }
}
