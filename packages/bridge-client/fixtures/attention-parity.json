  "openRequest": {
    "comment": "What a session is waiting on, asked once. An approval outranks a question \u2014 it is the one holding a tool call open. A question counts as open only when the durable Request says so, or when it is the newest thing the session did: an ask buried under later tool calls is one the runtime answered for itself. Expiry settles a durable Request; `now` below is the clock every runner uses.",
    "now": "2026-08-31T12:00:00Z",
    "cases": [
      {
        "case": "an idle session is waiting on nothing",
        "state": "idle",
        "approval": true,
        "question": true,
        "expect": "none"
      },
      {
        "case": "a held approval is the open request",
        "state": "waiting",
        "approval": true,
        "question": false,
        "expect": "approval"
      },
      {
        "case": "an approval outranks a question when both are pending",
        "state": "waiting",
        "approval": true,
        "question": true,
        "expect": "approval"
      },
      {
        "case": "a durable question with no approval is the open request",
        "state": "waiting",
        "approval": false,
        "question": true,
        "expect": "question"
      },
      {
        "case": "an expired approval falls through to the question",
        "state": "waiting",
        "approval": true,
        "approvalExpiresAt": "2026-08-31T11:00:00Z",
        "question": true,
        "expect": "question"
      },
      {
        "case": "an expired question opens nothing",
        "state": "waiting",
        "approval": false,
        "question": true,
        "questionExpiresAt": "2026-08-31T11:00:00Z",
        "expect": "none"
      },
      {
        "case": "the newest event being a question opens one without a durable request",
        "state": "waiting",
        "approval": false,
        "question": false,
        "events": [
          {
            "id": "q1",
            "kind": "question",
            "summary": "Which branch?",
