{
  "name": "agent-control-dashboard",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.3.4",
      "typescript": "^5"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check-types": "turbo check-types",
    "typecheck": "tsc --noEmit && tsc -p tools/oxlint --noEmit && turbo check-types",
    "dev": "turbo dev",
    "dev:native": "turbo -F native dev",
    "dev:server": "turbo -F server dev",
    "format": "oxfmt apps packages integrations scripts tools",
    "format:check": "oxfmt --check apps packages integrations scripts tools",
    "schema": "bun run apps/server/scripts/wire-schema.ts",
    "release:desktop": "bun run scripts/release-desktop.ts",
    "bench": "bun run scripts/bench-bridge.ts",
    "service": "bun run scripts/agent-deck-service.ts",
    "test": "bun test --cwd apps/server && bun test --cwd packages/agent-adapter && bun test --cwd packages/bridge-client && bun test --cwd integrations",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@agent-control-dashboard/config": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "catalog:",
    "knip": "^6.32.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "turbo": "^2.6.3",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.2.21"
}
