          "type": "string",
          "enum": [
            "session.registered",
            "session.state.changed",
            "turn.started",
            "turn.completed",
            "request.opened",
            "request.resolved",
            "user-input.requested",
            "user-input.resolved",
            "item.started",
            "item.updated",
            "item.completed",
            "token-usage.updated",
            "rate-limits.updated",
            "runtime.error"
